{
  "manifest_version": "0.2",
  "name": "pc-dev-kit",
  "display_name": "PC（iphone-dev-kit）",
  "version": "0.1.0",
  "description": "Windows の PC と Chrome を Claude が見て・動かす（容量・不具合の記録・PowerShell・画面の部品・Chrome のページを文字で読んでまとめて操作）。カオルのスイッチ（オフ・見るだけ・操作も可）と許可（ALLOW・10 分）で止められる。実際の作業は常駐役（pc-agent.exe）がする。",
  "author": {
    "name": "iwataka793"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iwataka793/iphone-dev-kit"
  },
  "server": {
    "type": "binary",
    "entry_point": "server/pc-mcp.exe",
    "mcp_config": {
      "command": "${__dirname}/server/pc-mcp.exe",
      "args": [],
      "env": {}
    }
  },
  "tools": [
    {
      "name": "pc_status",
      "description": "スイッチ・許可・最近の記録"
    },
    {
      "name": "pc_disk",
      "description": "容量を調べる"
    },
    {
      "name": "pc_problems",
      "description": "不具合の記録を集める"
    },
    {
      "name": "pc_processes",
      "description": "動いているプログラム"
    },
    {
      "name": "pc_apps",
      "description": "入っているアプリ・起動時に動くもの"
    },
    {
      "name": "pc_files",
      "description": "ファイルを見る"
    },
    {
      "name": "pc_screenshot",
      "description": "画面を撮る"
    },
    {
      "name": "pc_windows",
      "description": "開いている窓"
    },
    {
      "name": "pc_ui",
      "description": "窓の中の部品"
    },
    {
      "name": "pc_powershell",
      "description": "PowerShell を実行"
    },
    {
      "name": "pc_open",
      "description": "開く"
    },
    {
      "name": "pc_ui_do",
      "description": "部品を押す・入れる"
    },
    {
      "name": "pc_keys",
      "description": "キーボードで打つ"
    },
    {
      "name": "pc_trash",
      "description": "ごみ箱に送る"
    },
    {
      "name": "browser_tabs",
      "description": "Chrome のタブ"
    },
    {
      "name": "browser_read",
      "description": "Chrome のページを文字で読む"
    },
    {
      "name": "browser_do",
      "description": "Chrome でまとめて動かす"
    },
    {
      "name": "browser_js",
      "description": "Chrome のページで JavaScript"
    },
    {
      "name": "browser_screenshot",
      "description": "Chrome のページを撮る"
    }
  ],
  "compatibility": {
    "platforms": [
      "win32"
    ]
  },
  "license": "MIT"
}
